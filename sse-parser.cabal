cabal-version: 3.0
name: sse-parser
version: 0.1.0.0
synopsis: Incremental parser for text/event-stream (Server-Sent Events) as specified by the WHATWG HTML Living Standard
license: MIT
license-file: LICENSE
author: Nebula Lavelle
maintainer: nebula@franticdream.xyz
copyright: 2026 Nebula Lavelle
build-type: Simple

flag ci
  description: More strict ghc options used for development and ci, not intended for end-use.
  manual: True
  default: False

common foundation
  build-depends: base >=4.20 && <5

  if flag(ci)
    build-depends: henforcer
    ghc-options:
      -j
      -fwrite-ide-info
      -hiedir=.hie
      -Weverything
      -Werror
      -Wno-missing-import-lists
      -Wno-missing-local-signatures
      -Wno-monomorphism-restriction
      -Wno-missing-kind-signatures
      -Wprepositive-qualified-module
      -Wno-safe
      -Wno-unsafe
      -Wno-missing-safe-haskell-mode
      -Wno-missing-deriving-strategies
      -Wno-all-missed-specialisations
      -Wno-missed-specialisations
      -Wno-implicit-prelude
      -Wno-missing-role-annotations
      -Wno-unused-packages
      -fplugin
      Henforcer
  default-extensions:
    OverloadedStrings

library
  import: foundation
  exposed-modules: SSE.Parser
  build-depends:
    bytestring,
    text,

  hs-source-dirs: src
  default-language: GHC2024

test-suite sse-parser-test
  import: foundation
  type: exitcode-stdio-1.0
  main-is: Main.hs
  build-depends:
    bytestring,
    containers,
    hedgehog,
    sse-parser,
    tasty,
    tasty-hedgehog,
    text,

  hs-source-dirs: test
  default-language: GHC2024
  ghc-options:
    -rtsopts
    -threaded
    -with-rtsopts
    "-T -N"
